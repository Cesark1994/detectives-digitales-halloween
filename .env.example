PORT=3000
NODE_ENV=production
# Los ritmos se eligen al crear cada sala:
# tranquilo: Detectar 45 s / Decidir 30 s / Minijuego 60 s.
# clásico: Detectar 30 s / Decidir 20 s / Minijuego 35 s.
# Opcional: descomentar estos valores para fijar tiempos globales.
# Cada valor reemplaza el tiempo de esa etapa en ambos ritmos.
# DETECT_SECONDS=45
# DECIDE_SECONDS=30
# MINI_SECONDS=60
NO_BROWSER=1
